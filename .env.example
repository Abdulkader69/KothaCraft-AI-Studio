# Image generation (pick one) -------------------------------------------------
# pollinations  free, no key, no account. Ignores the requested size (comes back
#               ~576x1024 for a 1080x1920 ask) and is upscaled to fit.
# IMAGE_PROVIDER: cloudflare | pollinations | mflux | fal | openai | placeholder
IMAGE_PROVIDER=cloudflare

# mflux (local Apple Silicon) ----------------------------------------------------
# Runs 100% offline via Apple MLX. Fast, free, native metal GPU acceleration.
# npm run mflux:setup to install venv + weights (~5.9 GB)
MFLUX_MODEL=filipstrand/Z-Image-Turbo-mflux-4bit   # or dhairyashil/FLUX.1-schnell-mflux-4bit
MFLUX_STEPS=4                         # 4 steps for Z-Image-Turbo (fast & sharp)

POLLINATIONS_MODEL=               # blank lets the service choose (e.g. flux, turbo)
POLLINATIONS_SEED=                # blank derives a stable seed per prompt

# Cloudflare Workers AI — free daily allowance, better than pollinations ------
# SDXL honours width/height and negative prompts; flux-1-schnell does neither
# (square only) but is sharper. Token needs the Workers AI permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0   # or @cf/black-forest-labs/flux-1-schnell
CF_STEPS=                         # SDXL max 20, flux max 8

FAL_KEY=
OPENAI_API_KEY=

# Text to speech --------------------------------------------------------------
# kokoro      free, local, offline. `pip install kokoro-tts` + `npm run kokoro:setup`
# elevenlabs  paid API, but returns word alignment for free (best captions)
# placeholder silent tracks of the right length, for testing timing without either
# piper    Bangladeshi Bangla, 16 voices, MIT, ~0.6 s/scene.  npm run piper:setup
# vits-bd  Bangladeshi Bangla, one natural voice, Apache-2.0.   npm run vits-bd:setup
# edge     Microsoft neural voices incl. bn-BD Nabanita/Pradeep, free, no account, word timings —
#          but UNOFFICIAL (Edge's read-aloud endpoint); keep piper as fallback.  npm run edge:setup
# mms      1000+ languages but CC-BY-NC — NOT for commercial use
TTS_PROVIDER=kokoro               # kokoro | piper | vits-bd | edge | mms | gemini | elevenlabs | placeholder
EDGE_VOICE=bn-BD-NabanitaNeural   # or bn-BD-PradeepNeural; any name from `.venv-edge/bin/edge-tts --list-voices`
EDGE_RATE=+0%                     # -8% a touch slower, +10% faster
PLATFORM_VARIANT=                 # set by the pipeline per platform cut (ig|fb|yt|tt) — not normally set by hand
PRONOUNCE_FILE=                   # shared spellings-for-the-voice map; default content/pronounce.json
                                  # per-engine additions: content/pronounce.<TTS_PROVIDER>.json
                                  # audition a word: npm run say -- <spelling> <spelling> …
PIPER_SPEAKER=0                   # 0-15 — use "Audition all 16" in the UI to pick


# MMS (local) — Bangla and ~1,100 other languages kokoro cannot do -------------
# Needs torch + transformers in .venv; weights cache in ~/.cache/huggingface.
MMS_LANG=ben                      # ISO 639-3: ben Bangla, hin Hindi, urd Urdu, eng English
MMS_PYTHON=                       # blank uses .venv/bin/python

# kokoro (local) --------------------------------------------------------------
KOKORO_VOICE=af_sarah             # or blend: af_sarah:60,am_adam:40 (--help-voices)
KOKORO_LANG=en-us
KOKORO_BIN=kokoro-tts             # path to the CLI if it is not on your PATH
KOKORO_MODEL_DIR=                 # where kokoro-v1.0.onnx / voices-v1.0.bin live (default: project root)

# vits-bd: silence inserted after each sentence (। ! ? . …) and a shorter breath after , — ;
VITS_BD_PAUSE=0.35
VITS_BD_BREATH=0.18

# gemini tts (Google AI Studio / Gemini API, 130+ languages) ------------------
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts  # gemini-3.8-flash-tts | gemini-3.8-flash-lite-tts
GEMINI_VOICE=Kore                      # Kore, Aoede, Leda, Sulafat, Charon, Puck, Enceladus, Orus …
# GEMINI_TTS_STYLE=                    # Optional style/pacing direction

# elevenlabs (paid, for later) ------------------------------------------------
ELEVENLABS_API_KEY=
# Must be a *premade* voice on free plans — library voices give a 402.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# multilingual_v2 covers 29 languages but NOT Bengali — use eleven_v3 for Bangla.
ELEVENLABS_MODEL=eleven_v3

# ElevenLabs dialogue character profiles (auto-picked if voiceId is omitted or placeholder):
# ELEVENLABS_VOICE_MOTHER=EXAVITQu4vr4xnSDxMaL       # Sarah (warm, caring mother)
# ELEVENLABS_VOICE_DAUGHTER=MF3mGyEYCl7XYWbV9V6O     # Elli (sweet, youthful girl child)
# ELEVENLABS_VOICE_SON=TxGEqnHWrfWFTfGW9XjX          # Josh (young boy)
# ELEVENLABS_VOICE_FATHER=pNInz6obpgDQGcFmaJgB       # Adam (deep, dignified father)
# ELEVENLABS_VOICE_GRANDMOTHER=Xb7hH8MSUJpSbSDYk0k2   # Alice (elder female)
# ELEVENLABS_VOICE_GRANDFATHER=JBFqnCBsd6RMkjVDRZzb   # George (warm grandfatherly)

# Optional image-to-video (real motion instead of ffmpeg ken-burns) ------------
# Only used by scenes with "motion": "ai". Everything else stays on free ken-burns.
VIDEO_PROVIDER=fal                 # fal: remote, uses FAL_KEY | local: Wan 2.2 5B on this Mac (npm run wan:setup)
VIDEO_MODEL=fal-ai/wan/v2.2-5b/image-to-video
# VIDEO_LOCAL_SECONDS=3.4          # local clip length (81 frames); longer = slower + more memory
# VIDEO_LOCAL_STEPS=30             # 40 is the model's recommendation, 30 is a good trade

# Word-level captions ---------------------------------------------------------
# ElevenLabs returns word alignment for free during TTS. kokoro does not, so on
# kokoro set this to `local` (free, offline) for word-accurate captions —
# leaving it `off` falls back to length-weighted estimates.
WORD_TIMING=local                 # off | openai | local
WHISPER_MODEL=whisper-1
WHISPER_CMD=whisper --model base  # used when WORD_TIMING=local

# Fonts (leave blank to auto-detect) ------------------------------------------
# Bangla needs a Bengali-capable font or captions render as empty boxes:
#   FONT_FILE=/System/Library/Fonts/Supplemental/Bangla Sangam MN.ttc
#   CAPTION_FONT=Kohinoor Bangla
FONT_FILE=
CAPTION_FONT=

# UI ------------------------------------------------------------------------
UI_PORT=5180                       # the reels UI; 5173 is what Vite dev servers grab

# Publishing (optional) — see README "Publishing" for the two one-time setups ----
# Google Cloud OAuth client (Web application) with redirect http://localhost:5180/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Meta app (Business type) with Facebook Login, redirect http://localhost:5180/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
# TikTok app (Login Kit + Content Posting API), redirect http://localhost:5180/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

