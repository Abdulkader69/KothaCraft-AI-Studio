  "verses": [
    {
      "id": "01",
      "ayah": 1,
      "number": "١",
      "arabic": "قُلْ هُوَ ٱللَّهُ أَحَدٌ",
      "bangla": "বলুন, তিনিই আল্লাহ, এক ও অদ্বিতীয়।"
    },
    {
      "id": "02",
      "ayah": 2,
      "number": "٢",
      "arabic": "ٱللَّهُ ٱلصَّمَدُ",
      "bangla": "আল্লাহ কারও মুখাপেক্ষী নন, সবাই তাঁর মুখাপেক্ষী।"
    },
    {
      "id": "03",
      "ayah": 3,
      "number": "٣",
      "arabic": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
      "bangla": "তিনি কাউকে জন্ম দেননি, আর তাঁকেও জন্ম দেওয়া হয়নি।"
    },
    {
      "id": "04",
      "ayah": 4,
      "number": "٤",
      "arabic": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ",
      "bangla": "আর তাঁর সমতুল্য কেউ নেই।"
    }
  ]
