      "id": "01",
      "ayah": 1,
      "number": "١",
      "arabic": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "bangla": "বলুন, আমি আশ্রয় চাই মানুষের রবের কাছে।"
    },
    {
      "id": "02",
      "ayah": 2,
      "number": "٢",
      "arabic": "مَلِكِ ٱلنَّاسِ",
      "bangla": "মানুষের অধিপতির কাছে।"
    },
    {
      "id": "03",
      "ayah": 3,
      "number": "٣",
      "arabic": "إِلَٰهِ ٱلنَّاسِ",
      "bangla": "মানুষের উপাস্যের কাছে।"
    },
    {
      "id": "04",
      "ayah": 4,
      "number": "٤",
      "arabic": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
      "bangla": "আত্মগোপনকারী কুমন্ত্রণাদাতার অনিষ্ট থেকে।"
    },
    {
      "id": "05",
      "ayah": 5,
      "number": "٥",
      "arabic": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
      "bangla": "যে মানুষের অন্তরে কুমন্ত্রণা দেয়।"
    },
    {
      "id": "06",
      "ayah": 6,
      "number": "٦",
      "arabic": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",
      "bangla": "জিন ও মানুষের মধ্য থেকে।"
    }
  ]
